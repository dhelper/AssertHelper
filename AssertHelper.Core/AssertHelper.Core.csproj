<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
    <RootNamespace>AssertHelper.Core</RootNamespace>
    <AssemblyName>AssertHelper.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <Authors>Dror Helper</Authors>
    <Description>One assert to rule them all - supports NUnit and MSTest</Description>
    <Copyright>Copyright 2015-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dhelper/AssertHelper</PackageProjectUrl>
    <PackageTags>Unit-testing NUnit MSTest</PackageTags>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AssertHelper.Core.Tests" />
  </ItemGroup>

</Project>
